{
  "rewrites": [
    {
      "source": "/digital-marketing",
      "destination": "/digital-marketing.html"
    },
    {
      "source": "/ai-solution",
      "destination": "/ai-solution.html"
    },
    {
      "source": "/packages",
      "destination": "/packages.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/services/:path*",
      "destination": "/services.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
